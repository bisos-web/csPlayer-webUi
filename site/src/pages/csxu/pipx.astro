---
// An app node of content/tree (/csxu/pipx/): the PipxInfo island, following the csPlayer context
// (the selected package and module), in the tree's layout.
import TreeLayout from "../../layouts/TreeLayout.astro"
import PipxInfo from "../../apps/csxu/PipxInfo"
import { nodeAt } from "../../lib/contentTree.mjs"

const node = nodeAt("/csxu/pipx/")
---
<TreeLayout node={node}>
  <h1>{node.page.title}</h1>
  {node.page.description && <p class="description">{node.page.description}</p>}
  <PipxInfo client:only="react" />
</TreeLayout>
