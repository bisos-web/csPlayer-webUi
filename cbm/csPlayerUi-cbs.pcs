#!/usr/bin/env python

""" #+begin_org
* Overview and Relevant Pointers
csPlayerUi-cbs.pcs
cbs: Capability Bundle Specification  -- Based on a cba-sysd.cs seed
ws: An Web Service  --- /Service Component/ --- csPlayerUi.here, the csPlayer web UI
n:  No Data    -- Materialization is purely based on Realm-BPO
p:  Platform    -- Materialization is based on Platform-BPO (Site-BPO is not used)

No sbom (Node comes from the reactPlus leaf; Astro from site/package-lock.json) and no units (nginx
serves static files): only csPlayerUi-assemble.cs, which builds the site and installs its dns entry and
vhost. A site's leaf goes in collective/hereWeb's branchesOrdered after reactPlus (and after any capability
whose state it shows).
#+end_org """

from bisos.capability import cba_sysd_seed
from bisos.capability import cba_seed

cba_seed.setup(
    seedType="systemd",  # Extend using cba_sysd_seed.setup
    loader=None,
    sbom=None,
    assemble="/bisos/git/bxRepos/bisos-web/csPlayer-webUi/cbm/csPlayerUi-assemble.cs",
    materialize=None,
)

sysdUnitsListSite = [
]

cba_sysd_seed.setup(
    sysdUnitsList=sysdUnitsListSite,
)

cba_sysd_seed.plantWithWhich("cba-sysd.cs")
