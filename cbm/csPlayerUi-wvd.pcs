#!/usr/bin/env python

""" #+begin_org
* ~[Summary]~ :: A =PlantedCmndService= for csPlayerUi.here NGINX virtual-host (capWebVd) --- serves the built site
#+end_org """

from bisos.b import cs
import collections

from bisos.csSeed import seedsLib

from bisos.webCap import capWebVd_seed  # noqa: F401  # _atExit_

from bisos.webCap import capWebVd_seedInfo

from bisos.banna import tcpPorts

serverName = "csPlayerUi.here"
# Static files from astro build (cbm/csPlayerUi-assemble.cs -i siteBuild).
# By the repo's stable path (/bisos/git/bxRepos/...).
rootBaseDir = "/bisos/git/bxRepos/bisos-web/csPlayer-webUi/site/dist"

# The backend: csPlayerPerf (bisos-web/csPlayerPerf-drf), gunicorn on loopback. webCliGui calls /api/ on
# its own origin; /admin/ is Django's admin and /static/ its files (collected into csPlayerPerf's state dir).
perfUpstream = f"http://127.0.0.1:{tcpPorts.tcpPortsAssignedList.tcpPortsList['csPlayerPerf'].portNu}"
perfStaticDir = "/bisos/var/csPlayerPerf/static/"

def wvdConfigFunc() -> str:
    """webVd_nginxSites.atBaseSite, plus the site's own 404 page and the backend's locations."""
    proxyLines = """\
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;"""
    return f"""\
server {{
    listen 80;
    server_name {serverName};

    root {rootBaseDir};
    index index.html;

    location / {{
        try_files $uri $uri/ =404;
    }}

    location /api/ {{
        proxy_pass {perfUpstream};
{proxyLines}
    }}

    location /admin/ {{
        proxy_pass {perfUpstream};
{proxyLines}
    }}

    location /static/ {{
        alias {perfStaticDir};
    }}

    error_page 404 /404.html;
}}
"""

capWebVd_seedInfo.setup(
    serverName=serverName,
    proxyPort="NA",
    wvdConfigFunc=wvdConfigFunc,
)

from bisos.csSeed import csCmndsList_seedInfo
csCmnd = csCmndsList_seedInfo.csCmnd

csCmndsList = [
    csCmnd("configFileStdout", pars={'cls': 'configFile_nginxVd'},),
    csCmnd("configFileUpdate", pars={'cls': 'configFile_nginxVd', 'runAs': 'root'},),
    csCmnd("webVd_enable",),
    csCmnd("webVd_verify",),
    csCmnd("webVd_resolve",),
    csCmnd("webVd_fqdnPing",),
]

csCmndsList_seedInfo.setup(
    csCmndsList=csCmndsList,
)
